{
  "name": "@jotnardev/core",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens:build": "tsx scripts/build-tokens.ts",
    "build:css": "mkdir -p dist/tokens && cp src/tokens/tokens.css dist/tokens/",
    "build": "pnpm tokens:build && tsc && pnpm build:css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
