{
  "name": "@jotnardev/core",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens:build": "tsx scripts/build-tokens.ts",
    "build:css": "mkdir -p dist/tokens dist/components/Button/ && cp src/tokens/tokens.css dist/tokens/ && cp src/components/Button/Button.module.css dist/components/",
    "build": "pnpm tokens:build && tsc && pnpm build:css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
